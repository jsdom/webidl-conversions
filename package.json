{
  "name": "webidl-conversions",
  "version": "8.0.1",
  "description": "Implements the WebIDL algorithms for converting to and from JavaScript values",
  "keywords": [
    "types",
    "web",
    "webidl"
  ],
  "license": "BSD-2-Clause",
  "author": "Domenic Denicola <d@domenic.me> (https://domenic.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdom/webidl-conversions.git"
  },
  "files": [
    "lib/"
  ],
  "type": "commonjs",
  "main": "lib/index.js",
  "scripts": {
    "check": "npm run lint && npm run fmt:check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test",
    "coverage": "c8 node --test"
  },
  "devDependencies": {
    "@domenic/eslint-config": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "oxfmt": "0.75.0"
  },
  "c8": {
    "exclude": [
      "scripts/",
      "test/"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}
